<?xml version="1.0" encoding="UTF-8"?>
<openbox_config>
  <keyboard>
    <layout>us,ru</layout>
    <options>grp:alt_shift_toggle</options>
    <!-- Super+D → fuzzel (лаунчер приложений) -->
    <keybind key="W-d">
      <action name="Execute" command="fuzzel"/>
    </keybind>
    <!-- Super+Return → терминал -->
    <keybind key="W-Return">
      <action name="Execute" command="alacritty"/>
    </keybind>
    <!-- Super+Shift+N → редактор сетевых соединений -->
    <keybind key="W-S-n">
      <action name="Execute" command="nm-connection-editor"/>
    </keybind>
    <!-- Alt+Tab → переключение окон -->
    <keybind key="A-Tab">
      <action name="NextWindow"/>
    </keybind>
  </keyboard>
</openbox_config>
