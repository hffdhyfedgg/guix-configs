
// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "proxy": "",
    "edit_predictions": {

        "provider": "open_ai_compatible_api",
        "open_ai_compatible_api": {

            "max_output_tokens": 256,
            "api_url": "http://localhost:59997/v1/completions",
            "model": "phi-4-mini-instruct"
        }

    },
    "soft_wrap": "editor_width",
    "cli_default_open_behavior": "new_window",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "buffer_font_family": "JetBrainsMono Nerd Font Mono",
    "buffer_font_weight": 300.0,

    "gutter": {
        "min_line_number_digits": 2,
    },
    // "show_edit_predictions": false,
    "base_keymap": "VSCode",
    "icon_theme": "Zed (Default)",
    "vim_mode": true,

    "ui_font_size": 18,
    "buffer_font_size": 14,
    "tab_size": 4,

    "theme": {
        "mode": "dark",
        "light": "Ayu Light",
        "dark": "GitHub Dark Colorblind",
    },

    "languages": {
        "Python": {
            "format_on_save": "on",
        },
    },
    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
    },
    "theme_overrides": {
        "Gentle Dark (My)": {
            "hint": "#62647D",
        },
    },
    "file_types": {
        "Python": ["SCons*", "Scons*", "scons*"],
        "JavaScript": ["*.slint"],
        "C++": [
            "physicalProperties",
            "controlDict",
            "blockMeshDict",
            "fvSchemes",
            "fvSolution",
            "p",
            "U",
            "T",
        ],
    },
    // Подгружает файлы с переменными среды
    "file_scan_inclusions": [".env*"],
    "lsp": {
        "ltex": {
            "settings": {
                "ltex": {
                    "language": "ru-RU",
                },
            },
        },
    },
}


