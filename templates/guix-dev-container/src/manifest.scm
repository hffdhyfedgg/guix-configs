(specifications->manifest
 '(   ; Базовые утилиты и SSL-сертификаты
      "coreutils" "vim" "nss-certs"
      ;; зависимости для разработки
      "zsh"            ; оболочка для интерактивного входа
      "gcc-toolchain"  ; нужен для заголовков и библиотек (libstdc++)
      "glibc"          ; нужен для поиска динамического линковщика
      "patchelf"       ; для патчинга пре-компилированных бинарников (если потребуется)
      "file"           ; для определения ELF-файлов
      "zlib"           ; зависимость бэкенда (сжатие)
      "unzip"          ; Требуется для распаковки verus
      "openssl"        ; TLS для скачивания через cargo
      "pkg-config"     ; поиск нативных зависимостей при сборке
      "python"         ; нужен для некоторых вспомогательных скриптов
      "git"            ; нужен для работы с исходниками и репозиторием
      "curl"           ; скачивание установщика rustup и архивов
      "which"          ; поиск бинарников в скриптах
      "tar"            ; КРИТИЧНО: rustup использует tar для распаковки тулчейнов
      "xz"             ; КРИТИЧНО: тулчейны Rust сжаты в .tar.xz
      "graphviz"       ; NEW: отрисовка графов (agent-cli graphs dot)
      "bash"           ; NEW: запуск scripts/*.sh
 ))
