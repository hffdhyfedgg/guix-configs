#!/usr/bin/env python3
"""md-gen — сбор файлов проекта в единый поток с гибкой фильтрацией и форматированием.

Вывод по умолчанию в stdout. Служебная информация — в stderr и только с --verbose.
"""

import argparse
import os
import re
import sys
from pathlib import Path

try:
    import yaml
except ImportError:
    yaml = None

# ── константы ────────────────────────────────────────────────────────────────

DEFAULT_EXTENSIONS = (
    ".py",
    ".rs",
    ".c",
    ".cpp",
    ".h",
    ".hpp",
    ".js",
    ".ts",
    ".jsx",
    ".tsx",
    ".java",
    ".go",
    ".rb",
    ".php",
    ".swift",
    ".kt",
    ".scala",
    ".html",
    ".css",
    ".sql",
    ".json",
    ".yaml",
    ".yml",
    ".toml",
    ".ini",
    ".cfg",
    ".xml",
    ".md",
    ".sh",
    ".bash",
    ".zsh",
    ".scm",
)

DEFAULT_INCLUDE_PATTERNS = [
    r"^Dockerfile(\..+)?$",
    r"^Makefile$",
    r"^\.gitignore$",
    r"^\.dockerignore$",
]

DEFAULT_EXCLUDE_PATTERNS = [
    r"^\.git(/|$)",
    r"^__pycache__(/|$)",
    r"\.pyc$",
    r"^node_modules(/|$)",
    r"^\.venv(/|$)",
    r"^venv(/|$)",
    r"\.DS_Store$",
    r"^\.idea(/|$)",
    r"^\.vscode(/|$)",
    r"^dist(/|$)",
    r"^build(/|$)",
]

FORMATS = {
    "markdown": {
        "tree_open": "## Дерево проекта\n\n```\n",
        "tree_close": "\n```\n\n---\n\n",
        "file_open": "#### Файл: `{filename}`\n\n```{lang}\n",
        "file_close": "\n```\n",
        "file_sep": "\n---\n\n",
    },
    "plain": {
        "tree_open": "",
        "tree_close": "\n\n",
        "file_open": "=== {relpath} ===\n",
        "file_close": "\n",
        "file_sep": "\n",
    },
    "xml": {
        "tree_open": "<tree>\n",
        "tree_close": "\n</tree>\n\n",
        "file_open": '<file name="{relpath}" lang="{lang}">\n',
        "file_close": "\n</file>\n",
        "file_sep": "\n",
    },
}

EXT_LANG = {
    ".py": "python",
    ".rs": "rust",
    ".js": "javascript",
    ".ts": "typescript",
    ".jsx": "jsx",
    ".tsx": "tsx",
    ".c": "c",
    ".cpp": "cpp",
    ".h": "c",
    ".hpp": "cpp",
    ".java": "java",
    ".go": "go",
    ".rb": "ruby",
    ".php": "php",
    ".swift": "swift",
    ".kt": "kotlin",
    ".scala": "scala",
    ".html": "html",
    ".css": "css",
    ".sql": "sql",
    ".json": "json",
    ".yaml": "yaml",
    ".yml": "yaml",
    ".toml": "toml",
    ".xml": "xml",
    ".md": "markdown",
    ".sh": "bash",
    ".scm": "scheme",
}


# ── утилиты ──────────────────────────────────────────────────────────────────


def load_config(path: Path) -> dict:
    if yaml is None or not path.exists():
        return {}
    with open(path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f)
        return data if isinstance(data, dict) else {}


def compile_patterns(patterns: list[str]) -> list[re.Pattern]:
    compiled = []
    for p in patterns:
        try:
            compiled.append(re.compile(p))
        except re.error as e:
            print(f"⚠ Ошибка в шаблоне '{p}': {e}", file=sys.stderr)
    return compiled


def is_hidden(rel: str) -> bool:
    return any(part.startswith(".") for part in Path(rel).parts)


def get_lang(filename: str) -> str:
    return EXT_LANG.get(Path(filename).suffix.lower(), "")


def parse_size(s: str) -> int:
    s = s.strip().upper()
    if s.isdigit():
        return int(s)
    for unit, mult in (
        ("GB", 1024**3),
        ("G", 1024**3),
        ("MB", 1024**2),
        ("M", 1024**2),
        ("KB", 1024),
        ("K", 1024),
        ("B", 1),
    ):
        if s.endswith(unit):
            num = s[: -len(unit)]
            if num.isdigit():
                return int(num) * mult
    raise ValueError(f"Некорректный размер: {s}")


def apply_template(tpl: str, filename: str, relpath: str, lang: str) -> str:
    return (
        tpl.replace("{filename}", filename)
        .replace("{relpath}", relpath)
        .replace("{lang}", lang)
    )


def decode_escapes(s: str) -> str:
    return s.replace("\\n", "\n").replace("\\t", "\t")


# ── фильтрация ───────────────────────────────────────────────────────────────


def is_allowed(
    rel: str,
    is_dir: bool,
    include_hidden: bool,
    inc: list[re.Pattern],
    exc: list[re.Pattern],
    extensions: tuple[str, ...],
    include_no_ext: bool = False,
) -> bool:
    norm = rel.replace("\\", "/")
    if not include_hidden and is_hidden(norm):
        return False
    if any(r.search(norm) for r in exc):
        return False
    if is_dir:
        return True
    if any(r.search(norm) for r in inc):
        return True
    if extensions and norm.lower().endswith(extensions):
        return True
    if include_no_ext and Path(norm).suffix == "":
        return True
    return False


# ── сбор файлов ──────────────────────────────────────────────────────────────


def collect_files(
    src_dir: Path,
    extensions,
    include_hidden,
    inc,
    exc,
    include_no_ext,
    max_size_bytes=None,
    ignore_size_limit_exts=None,
    verbose=False,
):
    """Обходит src_dir. Возвращает (список обработанных файлов, множество всех прошедших фильтр путей)."""
    if ignore_size_limit_exts is None:
        ignore_size_limit_exts = set()

    collected = []  # [(relpath, filename, content), ...]
    filtered_paths = []  # все пути, прошедшие фильтр (для --full-tree)
    skipped = 0

    all_dirs = []
    for root, dirs, files in os.walk(src_dir):
        root_path = Path(root)
        rel_root = str(root_path.relative_to(src_dir)).replace("\\", "/")
        if rel_root == ".":
            rel_root = ""

        if rel_root and not is_allowed(
            rel_root, True, include_hidden, inc, exc, extensions, include_no_ext
        ):
            dirs[:] = []
            continue

        dirs[:] = [
            d
            for d in dirs
            if is_allowed(
                f"{rel_root}/{d}".lstrip("/"),
                True,
                include_hidden,
                inc,
                exc,
                extensions,
                include_no_ext,
            )
        ]
        all_dirs.append((root_path, rel_root, files))

    all_dirs.sort(key=lambda x: x[1])

    for root_path, rel_root, files in all_dirs:
        for fname in sorted(files):
            rel = f"{rel_root}/{fname}".lstrip("/") if rel_root else fname
            if not is_allowed(
                rel, False, include_hidden, inc, exc, extensions, include_no_ext
            ):
                continue

            filtered_paths.append(rel)
            fpath = root_path / fname
            ext = fpath.suffix.lower()

            if max_size_bytes is not None and ext not in ignore_size_limit_exts:
                try:
                    if fpath.stat().st_size > max_size_bytes:
                        if verbose:
                            print(f"⚠ Пропущен {rel} (размер)", file=sys.stderr)
                        skipped += 1
                        continue
                except OSError:
                    continue

            try:
                content = fpath.read_text(encoding="utf-8")
            except Exception as e:
                content = f"❌ Ошибка чтения: {e}"

            collected.append((rel, fname, content))

    if verbose:
        print(f"Файлов обработано: {len(collected)}", file=sys.stderr)
        if skipped:
            print(f"Пропущено по размеру: {skipped}", file=sys.stderr)

    return collected, filtered_paths


# ── дерево ───────────────────────────────────────────────────────────────────


def build_tree(src_dir_name: str, paths: list[str]) -> str:
    """Строит дерево из списка относительных путей."""
    tree: dict = {}
    for p in paths:
        node = tree
        for part in Path(p).parts:
            node = node.setdefault(part, {})

    def render(node: dict, prefix: str = "") -> list[str]:
        dirs = sorted((k for k, v in node.items() if v), key=str.lower)
        files = sorted((k for k, v in node.items() if not v), key=str.lower)
        ordered = dirs + files
        lines = []
        for i, name in enumerate(ordered):
            last = i == len(ordered) - 1
            conn = "└── " if last else "├── "
            suf = "/" if node[name] else ""
            lines.append(f"{prefix}{conn}{name}{suf}")
            if node[name]:
                lines.extend(render(node[name], prefix + ("    " if last else "│   ")))
        return lines

    return "\n".join([f"{src_dir_name}/"] + render(tree))


# ── main ─────────────────────────────────────────────────────────────────────


def main():
    ap = argparse.ArgumentParser(description="Сбор файлов проекта в единый поток.")
    ap.add_argument("src_dir", help="Директория-источник")
    ap.add_argument(
        "output_file",
        nargs="?",
        default=None,
        help="Выходной файл (по умолчанию: stdout)",
    )
    ap.add_argument("--conf", default=None)
    ap.add_argument(
        "--ext",
        default=None,
        help="Расширения через запятую. Пустая строка отключает фильтр по расширению",
    )
    ap.add_argument(
        "--include", default=None, help="Regex-шаблоны включения через запятую"
    )
    ap.add_argument(
        "--exclude", default=None, help="Regex-шаблоны исключения через запятую"
    )
    ap.add_argument("--include-hidden", action="store_true")
    ap.add_argument("--include-no-ext", action="store_true")
    ap.add_argument("--no-tree", action="store_true", help="Не выводить дерево")
    ap.add_argument(
        "--full-tree",
        action="store_true",
        help="Не обрезать дерево до обработанных файлов",
    )
    ap.add_argument("--max-size", default=None)
    ap.add_argument("--ignore-size-limit-ext", default=None)
    ap.add_argument(
        "--format",
        default="markdown",
        choices=["markdown", "plain", "xml"],
        help="Предустановленный формат вывода",
    )
    ap.add_argument(
        "--file-open",
        default=None,
        help="Шаблон перед файлом. Плейсхолдеры: {filename} {relpath} {lang}",
    )
    ap.add_argument("--file-close", default=None, help="Шаблон после файла")
    ap.add_argument("--file-sep", default=None, help="Разделитель между файлами")
    ap.add_argument(
        "--verbose", action="store_true", help="Служебная информация в stderr"
    )

    args = ap.parse_args()

    # ── конфиг ──
    cfg_path = (
        Path(args.conf) if args.conf else Path(__file__).parent / "md_gen_conf.yml"
    )
    file_cfg = load_config(cfg_path)

    ext = DEFAULT_EXTENSIONS
    inc_p = DEFAULT_INCLUDE_PATTERNS
    exc_p = DEFAULT_EXCLUDE_PATTERNS
    include_hidden = False
    include_no_ext = False
    max_size_raw = None
    ignore_ext = []

    for k, v in file_cfg.items():
        if k == "extensions":
            ext = tuple(v)
        elif k == "include_patterns":
            inc_p = v
        elif k == "exclude_patterns":
            exc_p = v
        elif k == "include_hidden":
            include_hidden = v
        elif k == "include_no_ext":
            include_no_ext = v
        elif k == "max_size":
            max_size_raw = v
        elif k == "ignore_size_limit_exts":
            ignore_ext = v

    if args.ext is not None:
        ext = tuple(e.strip() for e in args.ext.split(",") if e.strip())
    if args.include is not None:
        inc_p = [p.strip() for p in args.include.split(",") if p.strip()]
    if args.exclude is not None:
        exc_p = [p.strip() for p in args.exclude.split(",") if p.strip()]
    if args.include_hidden:
        include_hidden = True
    if args.include_no_ext:
        include_no_ext = True
    if args.max_size is not None:
        max_size_raw = args.max_size
    if args.ignore_size_limit_ext is not None:
        ignore_ext = [e.strip() for e in args.ignore_size_limit_ext.split(",")]

    max_size_bytes = None
    if max_size_raw is not None:
        try:
            max_size_bytes = (
                int(max_size_raw)
                if isinstance(max_size_raw, int)
                else parse_size(str(max_size_raw))
            )
        except ValueError as e:
            print(f"❌ {e}", file=sys.stderr)
            sys.exit(1)

    ignore_exts = set()
    for e in ignore_ext:
        e = e.strip()
        if e and not e.startswith("."):
            e = f".{e}"
        ignore_exts.add(e.lower())

    src = Path(args.src_dir).resolve()
    if not src.is_dir():
        print(f"❌ Не директория: {src}", file=sys.stderr)
        sys.exit(1)

    inc = compile_patterns(inc_p)
    exc = compile_patterns(exc_p)

    if args.verbose:
        print(f"Источник: {src}", file=sys.stderr)
        if max_size_bytes:
            print(f"Макс. размер: {max_size_bytes}", file=sys.stderr)

    # ── сбор ──
    collected, filtered_paths = collect_files(
        src,
        ext,
        include_hidden,
        inc,
        exc,
        include_no_ext,
        max_size_bytes,
        ignore_exts,
        args.verbose,
    )

    # ── формат ──
    fmt = dict(FORMATS[args.format])
    if args.file_open is not None:
        fmt["file_open"] = decode_escapes(args.file_open)
    if args.file_close is not None:
        fmt["file_close"] = decode_escapes(args.file_close)
    if args.file_sep is not None:
        fmt["file_sep"] = decode_escapes(args.file_sep)

    # ── дерево ──
    tree_text = None
    if not args.no_tree:
        tree_paths = filtered_paths if args.full_tree else [r for r, _, _ in collected]
        if tree_paths:
            tree_text = build_tree(src.name, tree_paths)

    # ── вывод ──
    out = []

    if tree_text:
        out.append(fmt["tree_open"])
        out.append(tree_text)
        out.append(fmt["tree_close"])

    for i, (rel, fname, content) in enumerate(collected):
        lang = get_lang(fname)
        out.append(apply_template(fmt["file_open"], fname, rel, lang))
        out.append(content)
        out.append(fmt["file_close"])
        if i < len(collected) - 1:
            out.append(fmt["file_sep"])

    result = "".join(out)

    if args.output_file:
        out_path = Path(args.output_file).resolve()
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(result, encoding="utf-8")
        if args.verbose:
            print(f"Записано: {out_path}", file=sys.stderr)
    else:
        sys.stdout.write(result)


if __name__ == "__main__":
    main()

