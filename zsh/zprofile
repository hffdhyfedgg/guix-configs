# ~/.zprofile
# Читается для login-оболочек.

# Режим производительности:
# 1 = Слабый ПК (оптимизации включены, меньше нагрузка на I/O/CPU)
# 0 = Мощный ПК (максимальные размеры истории и буферов)
export WEAK_PC=1

# Системный профиль и пользовательский профиль.
if [[ -f /etc/profile ]]; then
  . /etc/profile
fi

if [[ -f "$HOME/.profile" ]]; then
  . "$HOME/.profile"
fi
