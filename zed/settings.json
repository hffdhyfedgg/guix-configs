{
  "vim_mode": true,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_line_height" : "comfortable",
  "buffer_font_family" : "JetBrainsMono Nerd Font Mono",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard"
  },

  // 1. Отключаем телеметрию и метрики.
  // Фоновая отправка диагностических данных требует буферизации в памяти и сетевых запросов [[39], [44]].
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },


  // 5. Оптимизация сессии и буферов.
  // Zed хранит содержимое открытых файлов в памяти. Если вы закрыли редактор с открытым большим логом (40MB+), 
  // при следующем запуске он попытается восстановить его, что вызовет скачок RAM [[34]].
  "session": {
    "restore_unsaved_buffers": false
  },

  "lsp": {
    "rust-analyzer": {
      "settings": {
        "cargo": {
          "allTargets": false
        },
        "procMacro": {
          "enable": false
        },
        "checkOnSave": {
          "command": "check"
        },
        "lru": {
          "capacity": 128
        }
      }
    }
  },

}
